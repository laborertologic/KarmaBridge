generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO uuid field to work with URL
model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  firstName  String
  middleName String?
  lastName   String?
  password   String
  verified   Boolean  @default(false)
  posts      Post[]
  Job        Job[]
  Profile    Profile?
}

model Profile {
  id        Int     @id @default(autoincrement())
  bio       String?
  completed Boolean @default(false)
  authorId  Int     @unique
  author    User    @relation(fields: [authorId], references: [id])
}

