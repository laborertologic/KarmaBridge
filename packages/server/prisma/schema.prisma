model Post {
  id          Int       @id @unique @default(autoincrement())
  title       String
  subtitle    String
  content     String?
  published   Boolean   @default(false)
  author      User?     @relation(fields: [authorId], references: [id])
  authorId    Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  // files could be anything man
  // totalLikes
  // totalViews
}

model Job {
  id          Int       @id @unique @default(autoincrement())
  title       String
  subtitle    String
  content     String?
  published   Boolean   @default(false)
  author      User?     @relation(fields: [authorId], references: [id])
  authorId    Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
}
